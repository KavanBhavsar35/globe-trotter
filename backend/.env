# GlobeTrotter backend config — copy to `.env` and adjust. All values are optional
# (sensible localhost-demo defaults live in core/config.py).

# --- security / JWT ---
SECRET_KEY=dev-globetrotter-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
RESET_TOKEN_MINUTES=60

# --- database ---
DATABASE_URL=sqlite:///globetrotter.db

# --- frontend / CORS ---
FRONTEND_URL=http://localhost:3000
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- email ---
# console = print emails to the backend terminal (default, great for the demo)
# smtp    = send via a real SMTP server (fill EMAIL_HOST/PORT/USERNAME/PASSWORD)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@globetrotter.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
